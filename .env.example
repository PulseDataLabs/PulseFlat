# ==============================================================================
# PulseFlat - Arquivo de Exemplo de Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para '.env' e preencha com os seus valores reais.
# Exemplo: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Oracle Cloud / Database (Autonomous DB / mTLS Wallet)
# ------------------------------------------------------------------------------
ORACLE_DB_DSN=your_oracle_db_service_name_high
ORACLE_DB_USER=ADMIN
ORACLE_DB_PASSWORD=your_secure_db_password
ORACLE_DB_WALLET_PASSWORD=your_wallet_encryption_password
# Opcional (diretório local com cwallet.sso descompactado)
ORACLE_DB_WALLET_DIR=/path/to/oracle_wallet
# Opcional (conteúdo base64 do zip da wallet para pipelines CI/CD)
ORACLE_DB_WALLET_BASE64=

# ------------------------------------------------------------------------------
# 2. Notificações - Telegram Bot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# ------------------------------------------------------------------------------
# 3. Notificações - E-mail (SMTP)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USER=notificacoes@suaempresa.com.br
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=notificacoes@suaempresa.com.br
SMTP_TO=equipe_mesa@suaempresa.com.br,analistas@suaempresa.com.br
SMTP_SUBJECT=[PulseFlat] Alerta de Movimentação de Mercado

# ------------------------------------------------------------------------------
# 4. Notificações - Webhook (Power Automate / MS Teams / Discord)
# ------------------------------------------------------------------------------
POWER_AUTOMATE_WEBHOOK_URL=https://prod-XX.brazilsouth.logic.azure.com:443/workflows/...

# ------------------------------------------------------------------------------
# 5. APIs Externas e Credenciais
# ------------------------------------------------------------------------------
# S&P Global Scraper (Opcional: se não informado, extrai a chave pública da página)
SP_GLOBAL_API_KEY=your_sp_global_api_key_here

# ANBIMA Developers / ANBIMA Data (OAuth 2.0 - https://developers.anbima.com.br/pt/)
# Obtenha seu Client ID e Client Secret cadastrando-se no portal de desenvolvedores da ANBIMA.
# No GitHub Actions, cadastre em: Settings -> Secrets and variables -> Actions
# São aceitas as variáveis: ANBIMA_CLIENT_ID (ou API_ANBIMA_CLIENT_ID)
ANBIMA_CLIENT_ID=your_anbima_client_id_here
ANBIMA_CLIENT_SECRET=your_anbima_client_secret_here

# URLs opcionais da API ANBIMA (defaults já pré-configurados para o gateway oficial):
# ANBIMA_API_BASE_URL=https://api.anbima.com.br
# ANBIMA_OAUTH_URL=https://api.anbima.com.br/oauth/access-token

# Eulerpool Financial Data API (https://eulerpool.com/developers)
# Obtenha sua API Key gratuita no portal Eulerpool (plano free com 100k reqs/mês).
# No GitHub Actions, cadastre em: Settings -> Secrets and variables -> Actions
# São aceitas as variáveis: EULERPOOL_API_KEY (ou API_EULERPOOL_KEY / EULERPOOL_TOKEN)
EULERPOOL_API_KEY=your_eulerpool_api_key_here
# URL base opcional da Eulerpool (default: https://api.eulerpool.com):
# EULERPOOL_API_BASE_URL=https://api.eulerpool.com

# BrasilAPI (https://brasilapi.com.br/docs)
# API pública aberta brasileira (sem necessidade de chaves por padrão).
# URL base opcional para instâncias locais ou proxies:
# BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# BCB Olinda — Banco Central do Brasil (OData - https://olinda.bcb.gov.br/olinda/servico)
# API aberta de expectativas Focus, taxas de crédito bancário e tarifas.
# URL base opcional:
# BCB_OLINDA_BASE_URL=https://olinda.bcb.gov.br/olinda/servico

# Tesouro Transparente — Tesouro Nacional (CKAN - https://www.tesourotransparente.gov.br/ckan/api/3)
# API aberta do Tesouro Direto, Dívida Pública Federal (DPF) e leilões.
# URL base opcional:
# TESOURO_TRANSPARENTE_BASE_URL=https://www.tesourotransparente.gov.br/ckan/api/3

# FRED — Federal Reserve Economic Data (St. Louis Fed - https://fred.stlouisfed.org/docs/api/fred/)
# Obtenha sua API Key gratuita em: https://fred.stlouisfed.org/docs/api/api_key.html
# No GitHub Actions, cadastre em: Settings -> Secrets and variables -> Actions
FRED_API_KEY=your_fred_api_key_here
# URL base opcional do FRED:
# FRED_BASE_URL=https://api.stlouisfed.org/fred
